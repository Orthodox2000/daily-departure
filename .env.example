# Daily Departure - Environment Variables
# ----------------------------------------
# Frontend (Vite) needs nothing - it calls same-origin /api/leads.
# The serverless email integration reads these SERVER-SIDE variables:

# SelfIAM Mailer API key (https://mailer.selfiam.site) - REQUIRED
SELFIAM_MAILER_API_KEY=""

# Owner inbox that receives every enquiry notification - REQUIRED
OWNER_EMAIL="ankitmali50@mail.com"

# Display name shown as the sender in both emails
FROM_NAME="Daily Departures"

# Reply-To address on the customer auto-reply (your enquiries inbox)
REPLY_TO="webenquiry@dailydeparture.in"

# Public site URL - used to build absolute image URLs inside email HTML
SITE_URL="https://dailydeparture.in"

# Local dev API server port (dev-server.js, proxied by Vite)
DEV_SERVER_PORT=3001

# Optional: override the SelfIAM Mailer base URL
# SELFIAM_MAILER_BASE_URL="https://mailer.selfiam.site"
